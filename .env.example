VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Import script only; NEVER use VITE_ prefix for this key:
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional wind overlay endpoint. Empty uses the public Open-Meteo API (no key).
# For paid access, point this at your own /api/wind proxy.
VITE_OPEN_METEO_WIND_URL=
# Backend-only: your future proxy reads this; never prefix a private key with VITE_.
OPEN_METEO_API_KEY=
